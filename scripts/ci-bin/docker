#!/usr/bin/env bash
set -euo pipefail

: "${PTT_REAL_DOCKER:?PTT_REAL_DOCKER must point to the host Docker CLI}"
: "${DOCKER_CONFIG:?DOCKER_CONFIG must point to the isolated CI configuration}"

# Docker Desktop can silently fall back to the interactive macOS Keychain
# credential helper when a headless runner launches a CLI plugin such as
# Buildx. Buildx also resolves credentials through HOME, independently of the
# Docker CLI's --config flag, so give the Docker process an isolated home with
# the same anonymous configuration. Other tools in the workflow keep the
# runner's normal HOME.
isolated_home="$DOCKER_CONFIG/home"
mkdir -p "$isolated_home/.docker"
cp "$DOCKER_CONFIG/config.json" "$isolated_home/.docker/config.json"

HOME="$isolated_home" exec "$PTT_REAL_DOCKER" --config "$DOCKER_CONFIG" "$@"
